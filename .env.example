# Supabase (Local CLI defaults — run `supabase status` after `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_local_publishable_key
SUPABASE_SECRET_KEY=your_local_secret_key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Billing (Test Mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_your_pro_monthly_price_id
